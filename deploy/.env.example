# Deployment values. install.sh fills generated secrets.
PUBLIC_URL=https://your-domain.example
VERSION=latest
REGISTRY_IMAGE=registry.example.com/leadgen

# Generate by install.sh. Do not reuse these placeholder names.
DB_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
SECRET_KEY=
FERNET_KEY=

LICENSE_PUBLIC_KEY_PEM=
BRAND_NAME=LeadGen
BRAND_LOGO_URL=
SENDING_ENABLED=false

SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
SEND_WINDOW_DAYS=1,2,3,4,5

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_SMALL=llama-3.1-8b-instant
LLM_MODEL_LARGE=llama-3.3-70b-versatile

MAX_LLM_USD_PER_DAY=0
MAX_VERIFICATIONS_PER_DAY=0
MAX_SOURCE_CREDITS_PER_DAY=0

BACKUP_ENCRYPTION_KEY=
