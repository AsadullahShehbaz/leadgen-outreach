# Local Docker development settings.
# Copy this file to .env.dev and replace SECRET_KEY and FERNET_KEY.
# Never reuse production secrets here.

DATABASE_URL=postgresql://leadgen:leadgen_dev_password@db:5432/leadgen
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

PUBLIC_URL=http://localhost:5173
SECRET_KEY=
FERNET_KEY=

SENDING_ENABLED=false
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
SEND_WINDOW_DAYS=1,2,3,4,5

LICENSE_PUBLIC_KEY_PEM=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_SMALL=llama-3.1-8b-instant
LLM_MODEL_LARGE=llama-3.3-70b-versatile

MAX_LLM_USD_PER_DAY=0
MAX_VERIFICATIONS_PER_DAY=0
MAX_SOURCE_CREDITS_PER_DAY=0
OPTIMIZER_MINIMUM_SAMPLE=30
OPTIMIZER_OUTCOME_WINDOW_DAYS=14
ACCESS_TOKEN_EXPIRE_MINUTES=30
