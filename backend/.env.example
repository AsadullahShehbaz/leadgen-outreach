# Copy this file to backend/.env and fill in the real values.
# Never commit .env. Never share these URLs or passwords.

# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
# Use port 5432 (Session pooler), not 6543 (transaction pooler).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Separate Supabase project used ONLY by the migration integration test.
TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Sending window in the workspace local timezone (ISO weekdays: 1=Monday..7=Sunday).
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
SEND_WINDOW_DAYS=1,2,3,4,5

# Send engine. Keep this false until setup and mailbox checks are complete.
SENDING_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
PUBLIC_URL=https://your-domain.example
SECRET_KEY=
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
LICENSE_PUBLIC_KEY_PEM=

# Optional: test-only Redis for the limiter integration test.
TEST_REDIS_URL=redis://localhost:6379/15

# Daily vendor spend caps. Zero disables the corresponding paid workflow step.
MAX_LLM_USD_PER_DAY=0
MAX_VERIFICATIONS_PER_DAY=0
MAX_SOURCE_CREDITS_PER_DAY=0

# Groq is the default free-tier OpenAI-compatible provider.
# A client must supply and own the API key; do not use a shared key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_SMALL=llama-3.1-8b-instant
LLM_MODEL_LARGE=llama-3.3-70b-versatile
